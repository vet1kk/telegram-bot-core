#!/bin/sh
set -eu

run_check() {
    check_name="$1"
    shift

    echo "Running ${check_name}..."

    if ! "$@"; then
        echo "${check_name} failed. Please fix the issues before committing." >&2
        exit 1
    fi
}

if ! command -v composer >/dev/null 2>&1; then
    echo "Composer is required to run the local pre-commit hook." >&2
    exit 1
fi

if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    echo "Merge commit detected. Skipping pre-commit hook."
    exit 0
fi

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

run_check "Composer CS" composer phpcs
run_check "Psalm" composer phpcbf
run_check "Psalm" composer psalm
run_check "Composer test suite" composer test

echo "All checks passed. Proceeding with commit."
